PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecom_db
DB_USER=root
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRE=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Currency — QAR (Qatari Riyal). Used in emails, PDF invoices, schema.org
# product pricing, and payment gateway calls.
CURRENCY_SYMBOL=QAR
CURRENCY_CODE=QAR
CURRENCY_DECIMALS=2

# Store details shown on PDF invoices (all optional)
STORE_NAME=Fineline Solutions
STORE_ADDRESS=
STORE_PHONE=
STORE_TRN=          # UAE Tax Registration Number (printed on invoices)

# Server URL — used to build payment gateway server-to-server callback URLs
SERVER_URL=http://localhost:5000

# Tamara (Buy Now Pay Later — UAE/GCC). Setting TAMARA_API_TOKEN enables it
# as a checkout option. Get the token from the Tamara merchant portal.
TAMARA_API_TOKEN=
TAMARA_API_URL=https://api-sandbox.tamara.co   # production: https://api.tamara.co
# TAMARA_PAYMENT_TYPE=PAY_BY_INSTALMENTS       # or PAY_NOW / PAY_NEXT_MONTH
# TAMARA_INSTALMENTS=3

# Locale mirroring — set to true for stores that serve /ar/* alongside the
# default locale. Must match the client VITE_FEATURE_I18N flag: it drives the
# hreflang alternates in the served HTML and the /ar/* URLs in sitemap.xml.
FEATURE_I18N=false

# Multi-location inventory, POS and the ERP admin. Must match the client
# VITE_FEATURE_MULTILOC flag. When true, online orders draw down the
# ProductStock of the Location flagged isOnlineDefault instead of the
# aggregate Product.stock column — which is what keeps the storefront and
# the ERP from overwriting each other's stock figures.
# Run `npm run seed:erp` once after enabling.
FEATURE_MULTILOC=false
